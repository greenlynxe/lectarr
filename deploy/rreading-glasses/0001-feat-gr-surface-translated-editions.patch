diff --git a/internal/gr.go b/internal/gr.go
index 70e5060..dac358c 100644
--- a/internal/gr.go
+++ b/internal/gr.go
@@ -261,7 +261,37 @@ func (g *GRGetter) GetBook(ctx context.Context, bookID int64, saveEditions editi
 			if _, ok := editions[key]; ok {
 				continue // Already saw an edition similar to this one.
 			}
-			editions[key] = mapToWorkResource(edition, work) // Don't add any more editions like this one.
+			rsc := mapToWorkResource(edition, work)
+
+			// Translated editions are often credited to the translator (or a
+			// localized author profile) as their primary contributor, which
+			// would normally cause the controller to discard them. If the
+			// work's canonical author is still credited on the edition in a
+			// secondary role, re-attribute the edition to them so it survives.
+			canonicalID := work.BestBook.PrimaryContributorEdge.Node.LegacyId
+			if edition.PrimaryContributorEdge.Node.LegacyId != canonicalID {
+				for _, sce := range edition.SecondaryContributorEdges {
+					if sce.Node.LegacyId != canonicalID {
+						continue
+					}
+					// The outer book is the best edition of this work, so its
+					// primary contributor is the canonical author.
+					author := rsc.Authors[0]
+					canonical := book.PrimaryContributorEdge.Node
+					author.KCA = canonical.Id
+					author.Name = canonical.Name
+					author.ForeignID = canonical.LegacyId
+					author.URL = canonical.WebUrl
+					author.ImageURL = canonical.ProfileImageUrl
+					if desc := strings.TrimSpace(canonical.Description); desc != "" {
+						author.Description = html.UnescapeString(_stripTags.Sanitize(desc))
+					}
+					rsc.Authors[0] = author
+					break
+				}
+			}
+
+			editions[key] = rsc // Don't add any more editions like this one.
 		}
 		saveEditions(slices.Collect(maps.Values(editions))...)
 	}
